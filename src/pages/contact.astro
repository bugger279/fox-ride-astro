---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";

const contactMethods = [
  {
    icon: "phone",
    label: "Call Us",
    details: ["+91 9619434073", "+91 9920351607"],
    hours: "Mon–Sat, 9 AM – 7 PM IST",
  },
  {
    icon: "email",
    label: "Email Us",
    details: ["support@foxride.co.in"],
    hours: "24/7 — we respond within 4 hours",
  },
  {
    icon: "location",
    label: "Visit Us",
    details: ["Shop No. G4, Garnet Palladium", "Behind Express Zone, Goregaon East", "Mumbai – 400063"],
    hours: "Mon–Fri, 10 AM – 6 PM IST",
  },
];

const faqs = [
  {
    q: "What areas do you service?",
    a: "We provide IT services across PAN India with a strong presence in Mumbai, Pune, Delhi, Bangalore, and Chennai. Remote support is available nationwide.",
  },
  {
    q: "Do you offer emergency support?",
    a: "Yes. Our 24/7 NOC monitors your infrastructure and responds to critical incidents within SLA-defined timeframes. Emergency on-site support is available.",
  },
  {
    q: "What is your typical response time?",
    a: "For critical issues: within 1 hour. For standard requests: within 4 business hours. We maintain a 99.99% uptime SLA across all managed services.",
  },
  {
    q: "Can I get a custom solution for my business?",
    a: "Absolutely. Every engagement starts with a thorough assessment of your current infrastructure and business goals. We then design a tailored solution that fits your budget and scale.",
  },
];

const iconPaths: Record<string, string> = {
  phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  email: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  location: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
};
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Foxride Technologies for a free IT consultation. Call, email, or visit our Mumbai office."
>
  <PageBanner
    label="Get In Touch"
    title="CONTACT"
    highlight="US"
    subtitle="Ready to transform your IT infrastructure? Our team is here to help."
    breadcrumbs={[{ label: "Contact", href: "/contact" }]}
    bgColor="#061523"
  />

  <!-- ═══ CONTACT METHODS -->
  <section class="py-24 bg-white circuit-bg">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {contactMethods.map((method, i) => (
          <div class="bg-[#f0f4f8] p-8 border border-[#e2eaf2] hover:border-[#0d5578] transition-all group reveal" data-delay={i * 100}>
            <div class="w-14 h-14 bg-[#0d5578]/10 border border-[#0d5578]/20 flex items-center justify-center mb-6 group-hover:bg-[#0d5578] transition-colors">
              <svg class="w-6 h-6 text-[#0d5578] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[method.icon]} />
              </svg>
            </div>
            <h3 class="font-display font-bold text-[#061523] text-xl tracking-wide mb-4 group-hover:text-[#0d5578] transition-colors">{method.label.toUpperCase()}</h3>
            {method.details.map((detail) => (
              <p class="text-[#374151] text-sm leading-relaxed mb-1">{detail}</p>
            ))}
            <p class="text-[#6b7280] text-xs mt-4">{method.hours}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT FORM + MAP -->
  <section class="py-24 bg-[#f0f4f8]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Form -->
        <div class="bg-white p-10 border border-[#e2eaf2] reveal">
          <div class="section-label mb-2">Send Us a Message</div>
          <h2 class="font-display font-bold text-[#061523] text-2xl tracking-wide mb-6">REQUEST A FREE CONSULTATION</h2>
          
          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-display font-semibold tracking-widest uppercase text-[#6b7280] mb-2">Full Name</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-[#e2eaf2] text-sm text-[#061523] focus:outline-none focus:border-[#0d5578] transition-colors" placeholder="John Doe" />
              </div>
              <div>
                <label for="company" class="block text-xs font-display font-semibold tracking-widest uppercase text-[#6b7280] mb-2">Company</label>
                <input type="text" id="company" name="company" class="w-full px-4 py-3 border border-[#e2eaf2] text-sm text-[#061523] focus:outline-none focus:border-[#0d5578] transition-colors" placeholder="Your Company" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-xs font-display font-semibold tracking-widest uppercase text-[#6b7280] mb-2">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-[#e2eaf2] text-sm text-[#061523] focus:outline-none focus:border-[#0d5578] transition-colors" placeholder="john@company.com" />
              </div>
              <div>
                <label for="phone" class="block text-xs font-display font-semibold tracking-widest uppercase text-[#6b7280] mb-2">Phone</label>
                <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-[#e2eaf2] text-sm text-[#061523] focus:outline-none focus:border-[#0d5578] transition-colors" placeholder="+91 XXXXX XXXXX" />
              </div>
            </div>
            <div>
              <label for="service" class="block text-xs font-display font-semibold tracking-widest uppercase text-[#6b7280] mb-2">Service Interested In</label>
              <select id="service" name="service" class="w-full px-4 py-3 border border-[#e2eaf2] text-sm text-[#061523] focus:outline-none focus:border-[#0d5578] transition-colors bg-white">
                <option value="">Select a service</option>
                <option value="it-security">IT & Security Solutions</option>
                <option value="managed-services">IT Managed Services</option>
                <option value="cloud">Cloud Services & Data Centres</option>
                <option value="telecom">Telecommunication Services</option>
                <option value="leased-lines">Internet Leased Lines</option>
                <option value="hosting">Hosting Services</option>
                <option value="other">Other / Multiple</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-xs font-display font-semibold tracking-widest uppercase text-[#6b7280] mb-2">Message</label>
              <textarea id="message" name="message" rows="4" required class="w-full px-4 py-3 border border-[#e2eaf2] text-sm text-[#061523] focus:outline-none focus:border-[#0d5578] transition-colors resize-none" placeholder="Tell us about your requirements..."></textarea>
            </div>
            <button type="submit" class="btn-clip bg-[#e31e24] text-white font-display font-bold tracking-widest uppercase px-8 py-4 text-sm hover:bg-[#b81820] transition-colors w-full">
              Send Message
            </button>
          </form>

          <div id="form-status" class="mt-4 text-sm hidden"></div>
        </div>

        <!-- Map / Office Info -->
        <div class="reveal" data-delay="150">
          <div class="bg-[#061523] p-10 h-full relative overflow-hidden">
            <div class="circuit-bg absolute inset-0 opacity-20"></div>
            <div class="absolute top-0 left-0 w-1 h-full bg-[#e31e24]"></div>
            <div class="relative">
              <div class="section-label text-white/60 mb-2">Our Office</div>
              <h3 class="font-display font-bold text-white text-2xl tracking-wide mb-6">MUMBAI HEADQUARTERS</h3>
              
              <div class="space-y-6">
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-[#0d5578]/30 border border-[#0d5578]/40 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-[#0d5578]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths.location} />
                    </svg>
                  </div>
                  <div>
                    <p class="text-white/70 text-sm leading-relaxed">Shop No. G4, Garnet Palladium</p>
                    <p class="text-white/70 text-sm leading-relaxed">Behind Express Zone, Goregaon East</p>
                    <p class="text-white/70 text-sm leading-relaxed">Mumbai – 400063, Maharashtra</p>
                  </div>
                </div>
                
                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-[#0d5578]/30 border border-[#0d5578]/40 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-[#0d5578]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-white/50 text-xs tracking-widest uppercase mb-1">Business Hours</p>
                    <p class="text-white/70 text-sm">Mon–Fri: 10 AM – 6 PM IST</p>
                    <p class="text-white/70 text-sm">Sat: 10 AM – 2 PM IST</p>
                    <p class="text-white/40 text-xs mt-1">Support: 24/7</p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div class="w-10 h-10 bg-[#0d5578]/30 border border-[#0d5578]/40 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-[#0d5578]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths.phone} />
                    </svg>
                  </div>
                  <div>
                    <p class="text-white/50 text-xs tracking-widest uppercase mb-1">Phone</p>
                    <a href="tel:+919619434073" class="text-white/70 text-sm hover:text-white transition-colors block">+91 9619434073</a>
                    <a href="tel:+919920351607" class="text-white/70 text-sm hover:text-white transition-colors block">+91 9920351607</a>
                  </div>
                </div>
              </div>

              <!-- Map placeholder -->
              <div class="mt-8 border border-white/8 h-64 relative overflow-hidden group">
                <div id="google-map" class="absolute inset-0 w-full h-full grayscale-[0.3] contrast-[1.1]"></div>
                <div class="absolute bottom-4 left-4 z-10">
                  <a href="https://maps.google.com/?q=Garnet+Palladium+Goregaon+East+Mumbai" target="_blank" rel="noopener" class="bg-[#e31e24] text-white text-[10px] font-display font-bold tracking-widest uppercase px-4 py-2 hover:bg-[#b81820] transition-colors shadow-xl inline-flex items-center gap-2">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths.location} />
                    </svg>
                    Open in Maps
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ -->
  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-12">
      <div class="text-center mb-16">
        <div class="section-label justify-center reveal">Common Questions</div>
        <h2 class="font-display font-bold text-[#061523] leading-tight reveal text-[clamp(2rem,3.5vw,3rem)]">
          FREQUENTLY <span class="text-[#0d5578]">ASKED</span>
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <div class="faq-item border border-[#e2eaf2] transition-all duration-300 reveal overflow-hidden" data-delay={i * 80}>
            <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-[#f0f4f8] focus:outline-none transition-all group">
              <span class="font-display font-bold text-[#061523] text-sm md:text-base tracking-wide pr-4 group-hover:text-[#0d5578] transition-colors">{faq.q}</span>
              <div class="faq-icon-wrap w-8 h-8 rounded-full border border-[#e2eaf2] flex items-center justify-center group-hover:border-[#0d5578] group-hover:bg-[#0d5578]/5 transition-all">
                <svg class="faq-icon w-4 h-4 text-[#0d5578] flex-shrink-0 transition-transform duration-500 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </button>
            <div class="faq-answer overflow-hidden max-h-0 transition-all duration-500 ease-in-out opacity-0">
              <div class="px-6 pb-8 pt-2">
                <div class="w-10 h-1 bg-[#e31e24] mb-4 opacity-50"></div>
                <p class="text-[#6b7280] text-sm md:text-base leading-relaxed max-w-2xl">{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA -->
  <section class="py-16 bg-[#0d5578]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="font-display font-bold text-white text-3xl tracking-wide mb-4 reveal">STILL HAVE QUESTIONS?</h2>
      <p class="text-white/60 mb-8 reveal" data-delay="100">Our team is ready to help you find the right IT solution for your business.</p>
      <a href="tel:+919619434073" class="btn-clip bg-[#e31e24] text-white font-display font-bold tracking-widest uppercase px-8 py-4 text-sm hover:bg-[#b81820] transition-colors inline-block reveal" data-delay="200">
        Call Us Now: +91 96194 34073
      </a>
    </div>
  </section>

  <script is:inline src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCmL18misQw9KdwqGaw3zHkitj8vG6QF2Y&paint_origin=&libraries=geometry,search&v=weekly&loading=async&language=en&region=in&callback=onApiLoad"></script>
</BaseLayout>

<script>
  // Google Map Initialization
  (window as any).onApiLoad = () => {
    const mumbai = { lat: 19.1601, lng: 72.8595 }; // Garnet Palladium Coordinates
    const mapOptions = {
      zoom: 16,
      center: mumbai,
      styles: [
        { "featureType": "all", "elementType": "labels.text.fill", "stylers": [{ "color": "#ffffff" }] },
        { "featureType": "all", "elementType": "labels.text.stroke", "stylers": [{ "color": "#000000" }, { "lightness": 13 }] },
        { "featureType": "administrative", "elementType": "geometry.fill", "stylers": [{ "color": "#000000" }] },
        { "featureType": "administrative", "elementType": "geometry.stroke", "stylers": [{ "color": "#144b53" }, { "lightness": 14 }, { "weight": 1.4 }] },
        { "featureType": "landscape", "elementType": "all", "stylers": [{ "color": "#08304b" }] },
        { "featureType": "poi", "elementType": "geometry", "stylers": [{ "color": "#0c4152" }, { "lightness": 5 }] },
        { "featureType": "road.highway", "elementType": "geometry.fill", "stylers": [{ "color": "#000000" }] },
        { "featureType": "road.highway", "elementType": "geometry.stroke", "stylers": [{ "color": "#0b434f" }, { "lightness": 25 }] },
        { "featureType": "road.arterial", "elementType": "geometry.fill", "stylers": [{ "color": "#000000" }] },
        { "featureType": "road.arterial", "elementType": "geometry.stroke", "stylers": [{ "color": "#0b3d51" }, { "lightness": 16 }] },
        { "featureType": "road.local", "elementType": "geometry", "stylers": [{ "color": "#000000" }] },
        { "featureType": "transit", "elementType": "all", "stylers": [{ "color": "#146474" }] },
        { "featureType": "water", "elementType": "all", "stylers": [{ "color": "#021019" }] }
      ],
      disableDefaultUI: true,
      zoomControl: true,
    };
    
    const mapElement = document.getElementById('google-map');
    if (mapElement) {
      const map = new (window as any).google.maps.Map(mapElement, mapOptions);
      new (window as any).google.maps.Marker({
        position: mumbai,
        map: map,
        title: 'Foxride Technologies'
      });
    }
  };

  // FAQ accordion with smooth transitions
  document.querySelectorAll(".faq-item").forEach((item) => {
    const toggle = item.querySelector(".faq-toggle");
    const answer = item.querySelector(".faq-answer") as HTMLElement;
    const icon = item.querySelector(".faq-icon") as HTMLElement;
    const itemEl = item as HTMLElement;
    
    toggle?.addEventListener("click", () => {
      const isOpen = !answer.classList.contains("opacity-0");
      
      // Close all others
      document.querySelectorAll(".faq-item").forEach((otherItem) => {
        if (otherItem !== item) {
          otherItem.querySelector(".faq-answer")?.classList.add("opacity-0");
          (otherItem.querySelector(".faq-answer") as HTMLElement).style.maxHeight = "0";
          otherItem.querySelector(".faq-icon")?.classList.remove("rotate-180");
          otherItem.classList.remove("bg-[#f0f4f8]", "border-[#0d5578]");
        }
      });
      
      // Toggle current
      if (isOpen) {
        answer.classList.add("opacity-0");
        answer.style.maxHeight = "0";
        icon.classList.remove("rotate-180");
        itemEl.classList.remove("bg-[#f0f4f8]", "border-[#0d5578]");
      } else {
        answer.classList.remove("opacity-0");
        answer.style.maxHeight = answer.scrollHeight + "px";
        icon.classList.add("rotate-180");
        itemEl.classList.add("bg-[#f0f4f8]", "border-[#0d5578]");
      }
    });
  });

  // Form submission
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("form-status") as HTMLElement;
  
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    
    status.classList.remove("hidden", "text-[#0d5578]", "text-[#e31e24]");
    status.textContent = "Sending your message...";
    status.classList.add("text-[#0d5578]");
    
    await new Promise((resolve) => setTimeout(resolve, 1500));
    
    status.textContent = "Thank you! We'll get back to you within 4 hours.";
    form.reset();
  });
</script>
