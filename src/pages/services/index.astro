---
// src/pages/services/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import { services } from "../../data/services";

function serviceIconSVG(icon: string): string {
  const icons: Record<string, string> = {
    shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    settings: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
    cloud: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z",
    phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
    network: "M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0",
    server: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
  };
  const d = icons[icon] || icons.shield;
  return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="${d}"/>`;
}
---

<BaseLayout
  title="Our Services"
  description="ClearTech Services Pvt Ltd offers IT Managed Services, Cloud, Security, Telecom, Internet Leased Lines, and Hosting — all under one roof."
>
  <PageBanner
    label="What We Offer"
    title="ALL OUR"
    highlight="SERVICES"
    subtitle="End-to-end IT infrastructure and managed services — from cloud and security to connectivity and hosting."
    breadcrumbs={[{ label: "Services", href: "/services" }]}
  />

  <!-- Services Grid -->
  <section class="py-16 md:py-24 bg-white circuit-bg">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {services.map((service, i) => (
          <a
            href={`/services/${service.slug}`}
            class="group border border-[#e2eaf2] p-8 shadow-card hover:shadow-card-hover hover:border-[#0d5578]/50 transition-all duration-300 relative overflow-hidden bg-white reveal flex flex-col h-full"
            data-delay={i * 80}
          >
            <div class="absolute top-0 left-0 w-1 h-full bg-[#e31e24] transform scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>
            
            <div class="flex flex-col sm:flex-row items-start gap-6 h-full">
              <div class="w-16 h-16 bg-[#0d5578]/8 border border-[#0d5578]/20 flex items-center justify-center flex-shrink-0 group-hover:bg-[#0d5578] transition-colors duration-300">
                <svg class="w-7 h-7 text-[#0d5578] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={serviceIconSVG(service.icon)} />
              </div>
              <div class="flex-1 flex flex-col h-full">
                <div class="font-display text-xs tracking-widest uppercase text-[#e31e24] mb-1">{service.tagline}</div>
                <h3 class="font-display font-bold text-[#061523] text-xl tracking-wide mb-3 group-hover:text-[#0d5578] transition-colors">{service.title.toUpperCase()}</h3>
                <p class="text-[#6b7280] text-sm leading-relaxed mb-4">{service.description}</p>
                <div class="flex flex-wrap gap-2 mb-6">
                  {service.tags.map((tag) => (
                    <span class="text-xs text-[#0d5578] bg-[#0d5578]/8 px-2.5 py-1 border border-[#0d5578]/20">{tag}</span>
                  ))}
                </div>
                <div class="mt-auto flex items-center gap-2 text-[#e31e24] font-display font-semibold text-sm tracking-widest uppercase group-hover:gap-4 transition-all">
                  View Details <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#0d5578]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="font-display font-bold text-white text-3xl tracking-wide mb-4 reveal">NOT SURE WHICH SERVICE YOU NEED?</h2>
      <p class="text-white/60 mb-8 reveal" data-delay="100">Talk to our experts — we'll assess your needs and recommend the right solution.</p>
      <a href="/contact" class="btn-clip bg-[#e31e24] text-white font-display font-bold tracking-widest uppercase px-8 py-4 text-sm hover:bg-[#b81820] transition-colors inline-block reveal" data-delay="200">
        Get a Free Consultation
      </a>
    </div>
  </section>
</BaseLayout>
