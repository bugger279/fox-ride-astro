---
// src/pages/services/[slug].astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import { services } from "../../data/services";

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Get prev/next for navigation
const currentIndex = services.findIndex((s) => s.slug === service.slug);
const prevService =
  currentIndex > 0 ? services[currentIndex - 1] : services[services.length - 1];
const nextService =
  currentIndex < services.length - 1 ? services[currentIndex + 1] : services[0];
---

<BaseLayout title={service.title} description={service.description}>
  <PageBanner
    label={service.tagline}
    title={service.title.toUpperCase()}
    subtitle={service.description}
    breadcrumbs={[
      { label: "Services", href: "/services" },
      { label: service.shortTitle, href: `/services/${service.slug}` },
    ]}
    bgColor={service.heroImage}
  />

  <!-- ═══ OVERVIEW + FEATURES -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Sidebar: what's included -->
        <aside class="lg:col-span-1">
          <div class="bg-[#f0f4f8] p-6 sticky top-28">
            <div
              class="font-display font-bold text-[#061523] text-xs tracking-widest uppercase mb-4 flex items-center gap-2"
            >
              <span class="w-4 h-0.5 bg-[#e31e24]"></span> Service Tags
            </div>
            <div class="flex flex-wrap gap-2 mb-8">
              {
                service.tags.map((tag) => (
                  <span class="text-xs text-[#0d5578] bg-white border border-[#0d5578]/30 px-3 py-1.5">
                    {tag}
                  </span>
                ))
              }
            </div>

            <div
              class="font-display font-bold text-[#061523] text-xs tracking-widest uppercase mb-4 flex items-center gap-2"
            >
              <span class="w-4 h-0.5 bg-[#e31e24]"></span> Key Benefits
            </div>
            <ul class="space-y-3 mb-8">
              {
                service.benefits.map((benefit) => (
                  <li class="flex items-start gap-3 text-sm text-[#374151]">
                    <svg
                      class="w-4 h-4 text-[#0d5578] flex-shrink-0 mt-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    {benefit}
                  </li>
                ))
              }
            </ul>

            <a
              href="/contact"
              class="btn-clip bg-[#e31e24] text-white font-display font-bold tracking-widest uppercase px-6 py-3 text-sm hover:bg-[#b81820] transition-colors block text-center"
            >
              Get a Quote
            </a>
            <a
              href="tel:+919619434073"
              class="mt-3 btn-clip border-2 border-[#0d5578] text-[#0d5578] font-display font-bold tracking-widest uppercase px-6 py-3 text-sm hover:bg-[#0d5578] hover:text-white transition-colors block text-center"
            >
              Call Us Now
            </a>
          </div>
        </aside>

        <!-- Main content: features grid -->
        <div class="lg:col-span-2">
          <div class="section-label reveal">What's Included</div>
          <h2
            class="font-display font-bold text-[#061523] leading-tight mb-8 reveal"
            style="font-size: clamp(1.8rem, 3vw, 2.6rem);"
          >
            EVERYTHING YOU NEED IN<br /><span class="text-[#0d5578]"
              >{service.shortTitle.toUpperCase()}</span
            >
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              service.features.map((feature, i) => (
                <div
                  class="p-6 border border-[#e2eaf2] hover:border-[#0d5578] hover:shadow-md transition-all duration-300 group reveal"
                  data-delay={i * 70}
                >
                  <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-[#0d5578]/10 border border-[#0d5578]/20 flex items-center justify-center flex-shrink-0 group-hover:bg-[#0d5578] transition-colors">
                      <div class="w-2 h-2 bg-[#0d5578] group-hover:bg-white transition-colors" />
                    </div>
                    <div>
                      <h4 class="font-display font-bold text-[#061523] text-sm tracking-wide uppercase mb-1.5 group-hover:text-[#0d5578] transition-colors">
                        {feature.title}
                      </h4>
                      <p class="text-[#6b7280] text-sm leading-relaxed">
                        {feature.desc}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHY FOXRIDE FOR THIS SERVICE -->
  <section class="py-20 bg-[#061523] relative overflow-hidden">
    <div class="circuit-bg absolute inset-0 opacity-20"></div>
    <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#e31e24]"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="section-label reveal">Why Foxride</div>
          <h2
            class="font-display font-bold text-white leading-tight mb-4 reveal"
            style="font-size: clamp(1.8rem, 3vw, 2.6rem);"
          >
            YOUR TRUSTED PARTNER FOR<br /><span class="text-[#e31e24]"
              >{service.shortTitle.toUpperCase()}</span
            >
          </h2>
          <p class="text-white/60 leading-relaxed mb-6 reveal" data-delay="100">
            With 5+ years of hands-on experience, 250+ satisfied clients, and a
            team of certified experts — Foxride delivers {
              service.shortTitle.toLowerCase()
            } solutions that are reliable, cost-effective, and built to scale with
            your business.
          </p>
          <div class="flex flex-col gap-3 reveal" data-delay="150">
            {
              [
                "24/7 expert support with guaranteed SLAs",
                "Certified team with deep domain expertise",
                "Transparent pricing — no hidden costs",
                "Nationwide coverage across PAN India",
              ].map((point) => (
                <div class="flex items-center gap-3 text-white/70 text-sm">
                  <div class="w-5 h-5 bg-[#e31e24]/20 border border-[#e31e24]/40 flex items-center justify-center flex-shrink-0">
                    <svg
                      class="w-3 h-3 text-[#e31e24]"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  {point}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-px bg-white/5 reveal" data-delay="100">
          {
            [
              { num: "250+", label: "Happy Clients" },
              { num: "99.99%", label: "Uptime SLA" },
              { num: "5+", label: "Years Experience" },
              { num: "24/7", label: "Support Available" },
            ].map((stat) => (
              <div class="bg-[#061523] p-8 text-center border border-white/5">
                <div class="font-display font-bold text-white text-4xl mb-1">
                  {stat.num}
                </div>
                <div class="text-white/40 text-xs tracking-widest uppercase">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT CTA -->
  <section class="py-16 bg-[#f0f4f8]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="bg-[#0d5578] p-10 lg:p-14 relative overflow-hidden">
        <div class="circuit-bg absolute inset-0 opacity-20"></div>
        <div class="absolute top-0 right-0 bottom-0 w-1 bg-[#e31e24]"></div>
        <div
          class="relative grid grid-cols-1 lg:grid-cols-2 gap-8 items-center"
        >
          <div>
            <h3
              class="font-display font-bold text-white leading-tight mb-3"
              style="font-size: clamp(1.8rem, 3vw, 2.6rem);"
            >
              READY TO GET STARTED WITH<br /><span class="text-[#e31e24]"
                >{service.shortTitle.toUpperCase()}?</span
              >
            </h3>
            <p class="text-white/60 leading-relaxed">
              Talk to our team today. We'll assess your needs and build a
              tailored solution that fits your budget and scale.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4 lg:justify-end">
            <a
              href="/contact"
              class="btn-clip bg-[#e31e24] text-white font-display font-bold tracking-widest uppercase px-8 py-4 text-sm hover:bg-[#b81820] transition-colors text-center"
            >
              Get a Free Quote
            </a>
            <a
              href="tel:+919619434073"
              class="btn-clip border-2 border-white/40 text-white font-display font-bold tracking-widest uppercase px-8 py-4 text-sm hover:border-white transition-colors text-center"
            >
              +91 96194 34073
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PREV / NEXT SERVICE NAVIGATION -->
  <section class="py-12 bg-white border-t border-[#e2eaf2]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-2 gap-4">
        <a
          href={`/services/${prevService.slug}`}
          class="group flex items-center gap-4 p-5 border border-[#e2eaf2] hover:border-[#0d5578] transition-all"
        >
          <svg
            class="w-5 h-5 text-[#0d5578] group-hover:-translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path></svg
          >
          <div>
            <div
              class="text-[#6b7280] text-xs tracking-widest uppercase mb-0.5"
            >
              Previous
            </div>
            <div
              class="font-display font-bold text-[#061523] text-sm tracking-wide group-hover:text-[#0d5578] transition-colors"
            >
              {prevService.shortTitle.toUpperCase()}
            </div>
          </div>
        </a>
        <a
          href={`/services/${nextService.slug}`}
          class="group flex items-center justify-end gap-4 p-5 border border-[#e2eaf2] hover:border-[#0d5578] transition-all"
        >
          <div class="text-right">
            <div
              class="text-[#6b7280] text-xs tracking-widest uppercase mb-0.5"
            >
              Next
            </div>
            <div
              class="font-display font-bold text-[#061523] text-sm tracking-wide group-hover:text-[#0d5578] transition-colors"
            >
              {nextService.shortTitle.toUpperCase()}
            </div>
          </div>
          <svg
            class="w-5 h-5 text-[#0d5578] group-hover:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
