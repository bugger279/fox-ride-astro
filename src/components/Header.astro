---
// src/components/Header.astro
import { navLinks } from "../data/services";

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div
    class="header-inner flex items-center justify-between px-6 lg:px-12 h-20 transition-all duration-300"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group flex-shrink-0">
      <img src="/foxrideLogo.png" alt="Foxride Technologies" class="h-10 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {
        navLinks.map((link) => {
          if ("children" in link) {
            return (
              <div class="relative group">
                <a
                  href={link.href}
                  class={`nav-link font-display font-semibold text-sm tracking-widest uppercase text-white/80 hover:text-white transition-colors relative flex items-center gap-1 ${isActive(link.href) ? "active" : ""}`}
                >
                  {link.label}
                  <svg
                    class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path>
                  </svg>
                  <span
                    class={`absolute -bottom-1 left-0 h-0.5 bg-[#e31e24] transition-all duration-300 ${isActive(link.href) ? "w-full" : "w-0 group-hover:w-full"}`}
                  ></span>
                </a>

                <!-- Dropdown -->
                <div
                  class="dropdown absolute top-full left-0 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
                >
                  <div
                    class="bg-[#061523] border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] min-w-[240px] py-3 backdrop-blur-md"
                  >
                    {
                      link.children?.map((child) => (
                        <a
                          href={child.href}
                          class={`flex items-center gap-4 px-6 py-3 text-sm font-body transition-all hover:bg-[#e31e24] group/item ${pathname === child.href ? "text-white bg-[#e31e24]/20" : "text-white/70 hover:text-white"}`}
                        >
                          <span class="w-1.5 h-1.5 rounded-full bg-[#e31e24] group-hover/item:bg-white transition-colors flex-shrink-0" />
                          <span class="tracking-wide">{child.label}</span>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>
            );
          }
          return (
            <a
              href={link.href}
              class={`nav-link font-display font-semibold text-sm tracking-widest uppercase text-white/80 hover:text-white transition-colors relative group ${isActive(link.href) ? "active" : ""}`}
            >
              {link.label}
              <span
                class="nav-underline absolute -bottom-1 left-0 h-0.5 bg-[#e31e24] transition-all duration-300 w-0 group-hover:w-full"
              ></span>
            </a>
          );
        })
      }

      <a
        href="/contact"
        class="btn-clip bg-[#e31e24] text-white font-display font-bold text-sm tracking-widest uppercase px-7 py-3 hover:bg-[#b81820] transition-colors"
      >
        Get a Quote
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-toggle"
      class="lg:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
    >
      <span class="w-6 h-0.5 bg-white transition-all duration-300 block"></span>
      <span class="w-6 h-0.5 bg-white transition-all duration-300 block"></span>
      <span class="w-4 h-0.5 bg-white transition-all duration-300 block ml-auto"
      ></span>
    </button>
  </div>

  <!-- Mobile Nav -->
  <div
    id="mobile-nav"
    class="hidden lg:hidden bg-[#061523] border-t border-white/10 px-6 pb-6"
  >
    <div class="flex flex-col gap-1 pt-4">
      {
        navLinks.map((link) => {
          if ("children" in link) {
            return (
              <div class="py-3 border-b border-white/5">
                <div
                  class="font-display font-semibold text-sm tracking-widest uppercase text-white/50 mb-2"
                >
                  {link.label}
                </div>
                {
                  link.children?.map((child) => (
                    <a
                      href={child.href}
                      class={`block py-1.5 pl-4 text-sm font-body ${pathname === child.href ? "text-[#e31e24]" : "text-white/60"}`}
                    >
                      → {child.label}
                    </a>
                  ))
                }
              </div>
            );
          }
          return (
            <a
              href={link.href}
              class="mobile-nav-link py-3 border-b border-white/5 font-display font-semibold text-sm tracking-widest uppercase text-white/80"
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/contact"
        class="mt-4 btn-clip bg-[#e31e24] text-white font-display font-bold text-sm tracking-widest uppercase px-6 py-3 text-center"
        >Get a Quote</a
      >
    </div>
  </div>
</header>

<!-- Active link styles injected -->
<style>
  .nav-link.active {
    color: white !important;
  }
  .nav-link.active .nav-underline,
  .nav-link.active + .nav-underline {
    width: 100% !important;
  }
</style>

<script>
  // Scroll effect
  const header = document.getElementById("site-header");
  const inner = header?.querySelector(".header-inner");

  function updateHeader() {
    if (window.scrollY > 60) {
      header?.classList.add("bg-[#061523]/98", "shadow-xl", "backdrop-blur-md");
      header?.classList.remove("bg-transparent");
      inner?.classList.remove("h-20");
      inner?.classList.add("h-16");
    } else {
      header?.classList.remove(
        "bg-[#061523]/98",
        "shadow-xl",
        "backdrop-blur-md",
      );
      header?.classList.add("bg-transparent");
      inner?.classList.add("h-20");
      inner?.classList.remove("h-16");
    }
  }

  // Init
  if (window.scrollY === 0) {
    header?.classList.add("bg-transparent");
  } else {
    header?.classList.add("bg-[#061523]/98", "shadow-xl", "backdrop-blur-md");
  }

  window.addEventListener("scroll", updateHeader, { passive: true });

  // Mobile toggle
  const toggle = document.getElementById("mobile-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    mobileNav?.classList.toggle("hidden");
    const spans = toggle.querySelectorAll("span");
    spans[2].classList.toggle("w-4");
    spans[2].classList.toggle("w-6");
    spans[2].classList.toggle("ml-auto");
  });

  // Active link underline injection for active nav links
  document.querySelectorAll(".nav-link.active").forEach((link) => {
    const underline = link.querySelector(".nav-underline");
    if (underline) (underline as HTMLElement).style.width = "100%";
  });
</script>
